summarise(n_top = n(),
features = paste0(if_else(loading_sign > 0, "+", "−"), " ", pretty_feat(variable),
" (", round(100 * share), "%)", collapse = "<br>"),
.groups = "drop") %>%
mutate(features = paste0(features, "<br><small><i>", n_top, " of ", n_sig,
" significant features</i></small>")) %>%
select(basis, component, features)
# ---- 3. group comparisons ----
con_tab <- bind_rows(filter(coefs, basis == "pca"), coefs_sign) %>%
filter(domain == "all") %>%
mutate(cell = sprintf("%s%.2f<br>[%.2f, %.2f]%s<br><small>pd = %.3f</small>",
if_else(credible, "<b>", ""), estimate, .lower, .upper,
if_else(credible, "</b>", ""), pd)) %>%
select(basis, component, contrast, cell) %>%
pivot_wider(names_from = contrast, values_from = cell)
# ---- 4. convergence ----
conv_tab <- bind_rows(filter(conv, basis == "pca"), conv_sign) %>%
filter(str_starts(component, "all_")) %>%
transmute(basis, component,
diag = sprintf("%.3f<br>%.0f<br>%d", max_rhat, min_ess_bulk, as.integer(n_divergent)))
# ---- sample sizes for the note ----
n_info <- function(f) {
d <- f[["all_PC1"]]$data
sprintf("%d tokens, %d participants, %d concepts",
nrow(d), n_distinct(d$participant), n_distinct(d$concept))
}
basis_lab <- c(pca      = paste0("Pooled PCA: gesturers, learners, natives (", n_info(fits_pool), ")"),
signonly = paste0("Sign-only PCA: learners, natives (", n_info(fits_sign), ")"))
# ---- assemble ----
tab <- var_tab %>%
left_join(pc_labels, by = c("basis", "component")) %>%
left_join(feat_tab,  by = c("basis", "component")) %>%
left_join(con_tab,   by = c("basis", "component")) %>%
left_join(conv_tab,  by = c("basis", "component")) %>%
mutate(PC = str_remove(component, "all_"),
block = factor(basis_lab[basis], levels = basis_lab)) %>%
arrange(block, parse_number(PC))
for (cc in contr) if (!cc %in% names(tab)) tab[[cc]] <- NA_character_
gt_tab <- tab %>%
select(block, PC, label, variance, features, all_of(contr), diag) %>%
gt(groupname_col = "block") %>%
cols_label(
PC = "PC", label = "Interpretation",
variance = html("Variance<br>explained"),
features = html("Features up to 50%<br>of index loading"),
conventionalization = html("Conventionali-<br>zation<br><small>signers − gesture</small>"),
gesture_vs_native   = html("Gesture vs<br>native<br><small>native − gesture</small>"),
naive_vs_beginner   = html("Naïve vs<br>beginner<br><small>L2 − L1</small>"),
beginner_vs_native  = html("Beginner vs<br>native<br><small>native − L2</small>"),
learner_vs_native   = html("Learner vs<br>native<br><small>native − mean(L1, L2)</small>"),
diag = html("R̂ / ESS /<br>div.")
) %>%
tab_spanner("Dimension", columns = c(PC, label, variance, features)) %>%
tab_spanner("Group comparisons: estimate [95% CrI], SD units", columns = all_of(contr)) %>%
fmt_markdown(columns = c(variance, features, all_of(contr), diag)) %>%
sub_missing(missing_text = "—") %>%
cols_width(features ~ px(260), label ~ px(140)) %>%
tab_style(style = cell_text(size = px(11)), locations = cells_body()) %>%
tab_style(style = cell_text(weight = "bold"), locations = cells_row_groups()) %>%
tab_source_note(md(paste(
"**Dimensions.** PCA on standardized kinematic features (fine + gross), fitted separately on all groups (pooled) and on signers only.",
"Only PCs exceeding the permutation null and ≥ 5% variance are shown. Variance: observed ratio with 95% bootstrap percentile interval (1,000 resamples).",
"PC numbers are not comparable across blocks; ≈ marks the corresponding pooled dimension."))) %>%
tab_source_note(md(paste(
"**Features.** Significant features (index loading above permutation null) ranked by index loading, listed until 50% of the PC's summed index loading.",
"+/− = sign of the loading (+: higher feature value → higher PC score); % = share of the PC's index loading."))) %>%
tab_source_note(md(paste(
"**Models.** One Bayesian model per PC: score_z ~ 0 + group + (1 | participant) + (1 | concept), Gaussian;",
"priors Normal(0, 1) on group means, Exponential(1) on SDs and σ; 4 chains × 4,000 iterations (1,000 warm-up).",
"Contrasts extracted with emmeans (population level) as later/more sign-like minus earlier group, in SD units of the respective PCA's scores:",
"negative = the more sign-like group scores lower. **Bold** = 95% CrI excludes 0; pd = probability of direction.",
"Scores are z-scaled within each PCA, so magnitudes are not comparable across blocks."))) %>%
tab_source_note(md("**Diagnostics.** Max R̂ / min bulk ESS / number of divergent transitions per model."))
gt_tab
gtsave(gt_tab, "results/table_pca_dimensions.html")
```{r stimuli-per-participant, cache = FALSE}
tokens <- read_csv(file.path("Datasets", "pca_scores_all.csv"), show_col_types = FALSE)
# per participant: number of tokens and distinct concepts
per_participant <- tokens %>%
count(groupID, participant, name = "n_tokens") %>%
left_join(tokens %>% distinct(groupID, participant, concept) %>%
count(groupID, participant, name = "n_concepts"),
by = c("groupID", "participant")) %>%
arrange(groupID, participant)
per_participant %>% print(n = Inf)
# per group summary
per_participant %>%
group_by(groupID) %>%
summarise(n_participants = n(),
tokens_total   = sum(n_tokens),
tokens_min     = min(n_tokens),
tokens_median  = median(n_tokens),
tokens_max     = max(n_tokens),
.groups = "drop")
