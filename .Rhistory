fits_sign  <- res_sign$fits
stopifnot(!"Gesture" %in% fits_sign[["all_PC1"]]$data$groupID)   # sign-only really is sign-only
conv_sign %>%
mutate(flag = max_rhat > 1.01 | min_ess_bulk < 400 | n_divergent > 0) %>%
arrange(desc(flag), desc(max_rhat)) %>%
mutate(across(where(is.numeric), ~ round(.x, 3)))
coefs_sign %>%
mutate(across(c(estimate, .lower, .upper, pd), ~ round(.x, 2))) %>%
arrange(basis, domain, component, contrast)
library(tidyverse)
lvl_sign <- c("naive_vs_beginner",
"beginner_vs_native", "learner_vs_native")
lab_sign <- c(naive_vs_beginner   = "Naïve vs Beginner",   beginner_vs_native = "Beginner vs Native",
learner_vs_native = "Learner vs Native")
pal <- c(`credible ↑` = "#D1495B", `credible ↓` = "#3A7CA5", `not credible` = "#C9CCD1")
plot_df_sign <- coefs_sign %>%
filter(basis == "signonly") %>%
mutate(idx      = as.integer(str_extract(component, "[0-9]+$")),
pc       = fct_reorder(str_remove(component, "^(all|gross|fine)_"), idx, .desc = TRUE),
domain   = factor(domain, c("all", "gross", "fine"), c("ALL", "GROSS", "FINE")),
contrast = factor(contrast, levels = lvl_sign),
status   = factor(case_when(!credible ~ "not credible",
estimate > 0 ~ "credible ↑",
TRUE ~ "credible ↓"),
levels = names(pal)))
ggplot(plot_df_sign, aes(estimate, pc)) +
geom_vline(xintercept = 0, colour = "grey70", linewidth = .4, linetype = "22") +
geom_linerange(aes(xmin = .lower, xmax = .upper, colour = status,
linewidth = credible, alpha = credible), lineend = "round") +
geom_point(aes(fill = status, size = credible, alpha = credible),
shape = 21, colour = "white", stroke = 1) +
facet_grid(domain ~ contrast, labeller = labeller(contrast = lab_sign)) +
scale_colour_manual(values = pal, guide = "none") +
scale_fill_manual(values = pal, name = NULL,
guide = guide_legend(override.aes = list(size = 3.4, alpha = 1))) +
scale_linewidth_manual(values = c(`TRUE` = 1.1, `FALSE` = .6), guide = "none") +
scale_size_manual(values = c(`TRUE` = 2.7, `FALSE` = 1.8), guide = "none") +
scale_alpha_manual(values = c(`TRUE` = 1, `FALSE` = .5), guide = "none") +
labs(x = "effect (SD units, net of speaker)", y = NULL,
title = "Group comparisons across kinematic dimensions",
subtitle = "Unrotated PCA · point = posterior median, line = 95% CrI") +
theme_minimal(base_size = 11) +
theme(
panel.grid.major.y  = element_blank(),
panel.grid.minor    = element_blank(),
panel.grid.major.x  = element_line(colour = "grey93", linewidth = .5),
panel.spacing.x     = unit(10, "pt"),
panel.spacing.y     = unit(14, "pt"),
strip.text.x        = element_text(face = "bold", size = 9.5, colour = "grey15"),
strip.text.y        = element_text(face = "bold", size = 9.5, colour = "grey45", angle = -90),
axis.text.y         = element_text(size = 9),
axis.ticks          = element_blank(),
plot.title          = element_text(face = "bold", size = 15),
plot.subtitle       = element_text(colour = "grey55", size = 10, margin = margin(b = 10)),
plot.title.position  = "plot",
legend.position     = "top",
legend.justification = "right"
)
read_loadings_so <- function(domain) {
path <- file.path("Datasets", sprintf("loadings_%s_signonly.csv", domain))  # adjust folder
if (!file.exists(path)) return(NULL)
read_csv(path, show_col_types = FALSE) %>%
mutate(component   = paste0(domain, "_PC", PC),
basis       = "signonly",
sig_loading = CI_above_null_after)
}
loadings_sign <- map_dfr(c("all", "gross", "fine"), read_loadings_so)
# guard: silent empty joins
stopifnot(nrow(loadings_sign) > 0,
all(c("variable", "obs_index", "loading_sign", "sig_loading") %in% names(loadings_sign)))
interpretation_sign <- coefs_sign %>%
filter(credible) %>%
select(basis, component, contrast, effect = estimate) %>%
inner_join(loadings_sign, by = c("basis", "component")) %>%
filter(sig_loading) %>%
mutate(
# split leading category ("gross__rwrist") from the measure ("speed_mean")
has_cat  = str_detect(variable, "^[^_]+__[^_]+__"),
category = if_else(has_cat, str_extract(variable, "^[^_]+__[^_]+"), NA_character_),
measure  = if_else(has_cat, str_remove(variable, "^[^_]+__[^_]+__"), variable),
# ∝ signed loading WITHIN a PC (index = loading² · eig²; eig constant per PC)
loading_signed = loading_sign * sqrt(obs_index),
# contrasts are (later - earlier), so this reads as "the more sign-like group has..."
moves    = if_else(sign(effect) == sign(loading_sign), "↑ more", "↓ less")
) %>%
select(basis, contrast, component, effect, category, measure, moves,
loading_signed, obs_index, is_anchor, variable) %>%
arrange(basis, contrast, component, category, desc(obs_index))
interpretation_sign
write_csv(coefs_sign,          "results/comparisons_by_component_signonly.csv")
write_csv(conv_sign,           "results/convergence_signonly.csv")
#write_csv(loo_tab,        "results/loo_diagnostics_signonly.csv")
write_csv(interpretation_sign, "results/interpretation_features_signonly.csv")
# sign-only models are `fits_sign` (loaded above); helpers from §2
comps_sign <- c("all_PC1", "all_PC3", "all_PC4")
stopifnot(all(comps_sign %in% names(fits_sign)),
!"Gesture" %in% fits_sign[["all_PC1"]]$data$groupID)   # sanity check: no gesturers
comp_lab_sign <- c(all_PC1 = "PC1 · vigor / amplitude\n(lower = less vigorous)",
all_PC3 = "PC3 · segmentation / amount\n(lower = fewer segments, less movement)",
all_PC4 = "PC4 · fluency + handshape size\n(lower = more fluent, smaller handshapes)")
# speaker grid
spk_sign <- map_dfr(comps_sign, get_comp_data, fits = fits_sign) %>%
mutate(participant = as.character(participant),
who = who_of(participant, groupID)) %>%
group_by(component, who, participant) %>%
summarise(mean = mean(score), se = sd(score) / sqrt(n()), n = n(), .groups = "drop") %>%
mutate(label = spk_label(participant), panel = comp_lab_sign[component])
ggplot(spk_sign, aes(mean, tidytext::reorder_within(label, mean, panel), colour = who)) +
geom_vline(xintercept = 0, linetype = 2, colour = "grey70") +
geom_pointrange(aes(xmin = mean - 2 * se, xmax = mean + 2 * se), na.rm = TRUE) +
tidytext::scale_y_reordered() +
facet_wrap(~ panel, scales = "free", nrow = 1) +
scale_colour_manual(values = pal_who, name = NULL) +
labs(x = "PC score (z, sign-only PCA)", y = NULL) +
theme_minimal() + theme(legend.position = "top")
con_sign <- map_dfr(comps_sign, get_comp_data, fits = fits_sign) %>%
mutate(who = who_of(as.character(participant), groupID)) %>%
group_by(component, who, concept) %>%
summarise(mean = mean(score), se = sd(score) / sqrt(n()), n = n(), .groups = "drop") %>%
mutate(panel = comp_lab_sign[component])
ggplot(con_sign, aes(mean, tidytext::reorder_within(concept, mean, panel), colour = who)) +
geom_vline(xintercept = 0, linetype = 2, colour = "grey70") +
geom_linerange(aes(xmin = mean - 2 * se, xmax = mean + 2 * se),
position = position_dodge(width = .6), alpha = .5, na.rm = TRUE) +
geom_point(aes(size = n), position = position_dodge(width = .6), alpha = .9) +
tidytext::scale_y_reordered() +
facet_wrap(~ panel, scales = "free", nrow = 1) +
scale_colour_manual(values = pal_who, name = NULL) +
scale_size_area(max_size = 3, name = "tokens") +
labs(x = "PC score (z, sign-only PCA)", y = NULL) +
theme_minimal() + theme(legend.position = "top", axis.text.y = element_text(size = 6))
library(tidyverse); library(brms); library(tidybayes); library(emmeans)
# runs on the POOLED models (`fits_pool`); model_id, natives, other_id, spk_label and
# get_comp_data() are defined in §2 ("Speaker- and concept-level plots")
fluency <- c("all_PC4", "gross_PC3")
form    <- c("all_PC2", "fine_PC2")          # pooled basis
stopifnot(all(c(fluency, form) %in% names(fits_pool)))
sign_w <- c(0, 0, -1, 1)                     # Sign - L2, pooled levels: Gesture, L1, L2, Sign
per_spk <- map_dfr(fluency, get_comp_data, fits = fits_pool) %>%
group_by(component, groupID, participant) %>%
summarise(mean = mean(score), se = sd(score) / sqrt(n()), n = n(), .groups = "drop") %>%
mutate(label = spk_label(as.character(participant)))
per_spk %>% arrange(component, mean) %>% print(n = Inf)
ggplot(per_spk, aes(mean, tidytext::reorder_within(label, mean, component), colour = groupID)) +
geom_vline(xintercept = 0, linetype = 2, colour = "grey70") +
geom_pointrange(aes(xmin = mean - 2 * se, xmax = mean + 2 * se)) +
tidytext::scale_y_reordered() +
facet_wrap(~ component, scales = "free") +
labs(x = "fluency score (z; lower = more fluent)", y = NULL) +
theme_minimal()
spk_post <- map_dfr(fluency, \(k)
fits_pool[[k]] %>%
add_epred_draws(newdata = distinct(fits_pool[[k]]$data, participant, groupID),
re_formula = ~ (1 | participant)) %>%
median_qi(.epred) %>% mutate(component = k))
spk_post %>% filter(groupID == "Sign") %>%
mutate(label = spk_label(as.character(participant))) %>%
select(component, label, .epred, .lower, .upper)
spk_post %>% filter(groupID %in% c("Learner_1", "Learner_2")) %>%
group_by(component, groupID) %>%
summarise(min = min(.epred), median = median(.epred), max = max(.epred), .groups = "drop")
loo_native <- map_dfr(natives, \(nat) map_dfr(fluency, \(k) {
f <- update(fits_pool[[k]], newdata = filter(fits_pool[[k]]$data, participant != nat),
recompile = FALSE, seed = 1)      # drop recompile = FALSE if update() complains
emmeans(f, ~ groupID) %>%
contrast(list(beginner_vs_native = sign_w)) %>%
gather_emmeans_draws() %>% median_qi(.value) %>%
mutate(component = k, dropped = spk_label(nat))
}))
loo_native %>% select(component, dropped, .value, .lower, .upper)
handshape <- "fine_PC2"                      # pooled basis
per_spk_hs <- get_comp_data(handshape, fits_pool) %>%
group_by(component, groupID, participant) %>%
summarise(mean = mean(score), se = sd(score) / sqrt(n()), n = n(), .groups = "drop") %>%
mutate(label = spk_label(as.character(participant)))
per_spk_hs %>% arrange(mean) %>% print(n = Inf)
ggplot(per_spk_hs, aes(mean, fct_reorder(label, mean), colour = groupID)) +
geom_vline(xintercept = 0, linetype = 2, colour = "grey70") +
geom_pointrange(aes(xmin = mean - 2 * se, xmax = mean + 2 * se)) +
labs(x = "handshape-size score (z; lower = smaller, more stable handshapes)",
y = NULL, title = handshape) +
theme_minimal()
dist_comp <- function(k) {
dk  <- get_comp_data(k, fits_pool)
ref <- dk %>% filter(participant %in% natives) %>%
group_by(participant, concept) %>% summarise(ref = mean(score), .groups = "drop") %>%
mutate(ref_id = if_else(participant == model_id, "model", "other")) %>%
select(concept, ref_id, ref)
dk %>% filter(groupID %in% c("Learner_1", "Learner_2")) %>%
inner_join(ref, by = "concept", relationship = "many-to-many") %>%
mutate(dist = abs(score - ref))
}
dists <- map_dfr(c(form, fluency), dist_comp) %>%
mutate(axis = if_else(component %in% form, "form", "fluency"))
per_learner <- dists %>%
group_by(axis, component, groupID, participant, ref_id) %>%
summarise(dist = median(dist), .groups = "drop") %>%
pivot_wider(names_from = ref_id, values_from = dist) %>%
mutate(model_minus_other = model - other)      # negative = closer to model
per_learner %>%
group_by(axis, component, groupID) %>%
summarise(median_diff = median(model_minus_other),
share_closer_model = mean(model_minus_other < 0),
n_learners = n(), .groups = "drop")
axes <- c(x = "all_PC2", y = "all_PC4")
# model-based group means, net of speaker & concept
grp_means <- map_dfr(axes, \(k)
emmeans(fits_pool[[k]], ~ groupID, re_formula = NA) %>%
gather_emmeans_draws() %>% median_qi(.value) %>%
mutate(component = k)) %>%
select(groupID, component, .value, .lower, .upper) %>%
pivot_wider(names_from = component, values_from = c(.value, .lower, .upper))
# speaker means (raw) on the same two axes
spk_xy <- spk_pool %>%
filter(component %in% axes) %>%
select(who, participant, component, mean) %>%
pivot_wider(names_from = component, values_from = mean)
# within-learner L1 -> L2 arrows (complete learners only)
arrows <- spk_xy %>%
filter(who %in% c("Learner_1", "Learner_2")) %>%
pivot_wider(id_cols = participant, names_from = who, values_from = all_of(unname(axes))) %>%
drop_na()
ggplot() +
geom_hline(yintercept = 0, colour = "grey85") + geom_vline(xintercept = 0, colour = "grey85") +
geom_point(data = spk_xy, aes(.data[[axes["x"]]], .data[[axes["y"]]], colour = who),
alpha = .35, size = 2) +
geom_segment(data = arrows,
aes(x = .data[[paste0(axes["x"], "_Learner_1")]], y = .data[[paste0(axes["y"], "_Learner_1")]],
xend = .data[[paste0(axes["x"], "_Learner_2")]], yend = .data[[paste0(axes["y"], "_Learner_2")]]),
arrow = arrow(length = unit(5, "pt")), colour = "grey45", linewidth = .4) +
geom_errorbar(data = grp_means, width = 0, linewidth = .8,
aes(x = .data[[paste0(".value_", axes["x"])]],
ymin = .data[[paste0(".lower_", axes["y"])]], ymax = .data[[paste0(".upper_", axes["y"])]],
colour = groupID)) +
geom_errorbarh(data = grp_means, height = 0, linewidth = .8,
aes(y = .data[[paste0(".value_", axes["y"])]],
xmin = .data[[paste0(".lower_", axes["x"])]], xmax = .data[[paste0(".upper_", axes["x"])]],
colour = groupID)) +
geom_point(data = grp_means, size = 4, shape = 21, fill = "white", stroke = 1.4,
aes(.data[[paste0(".value_", axes["x"])]], .data[[paste0(".value_", axes["y"])]],
colour = groupID)) +
scale_colour_manual(values = c(pal_who, Sign = "#8E44AD"), name = NULL) +
labs(x = "PC2 · segmentation / amount  (← fewer segments, less movement)",
y = "PC4 · fluency + handshape  (↓ more fluent, smaller handshapes)",
title = "Form vs execution",
subtitle = "open circles = model-based group means ± 95% CrI; faint points = speakers; arrows = learners L1 → L2") +
coord_equal() + theme_minimal() + theme(legend.position = "top")
library(gt)
contr <- c("conventionalization", "gesture_vs_native", "naive_vs_beginner",
"beginner_vs_native", "learner_vs_native")
# ---- your interpretive labels (fill in / adjust; NA shows as "—") ----
pc_labels <- tribble(
~basis,     ~component, ~label,
"pca",      "all_PC1",  "Vigor / amplitude",
"pca",      "all_PC2",  "Segmentation / amount of movement",
"pca",      "all_PC3",  NA,
"pca",      "all_PC4",  "Fluency + handshape size",
"pca",      "all_PC5",  "Spectral balance",
"signonly", "all_PC1",  "Vigor / amplitude (≈ pooled PC1)",
"signonly", "all_PC2",  NA,
"signonly", "all_PC3",  "Segmentation / amount (≈ pooled PC2)",
"signonly", "all_PC4",  "Fluency + handshape size (≈ pooled PC4)"
)
# ---- 1. variance explained (bootstrap 95% percentile interval) ----
var_tab <- read_csv("Datasets/pca_variance_explained.csv", show_col_types = FALSE) %>%
filter(domain == "all") %>%
transmute(basis, component = paste0("all_PC", PC),
variance = sprintf("%.1f%%<br>[%.1f, %.1f]<br><small>cum. %.0f%%</small>",
100 * var_exp, 100 * var_low, 100 * var_high, 100 * cum_var))
# ---- 2. features up to 50% of the PC's index loading ----
pretty_feat <- function(v) v %>% str_replace_all("__", " · ") %>% str_replace_all("_", " ")
feat_tab <- bind_rows(read_loadings("pca", "all"), read_loadings("signonly", "all")) %>%
add_count(basis, component, name = "n_sig") %>%                 # all significant features
filter(within_50pct) %>%
arrange(basis, component, desc(share)) %>%
group_by(basis, component, n_sig) %>%
summarise(n_top = n(),
features = paste0(if_else(loading_sign > 0, "+", "−"), " ", pretty_feat(variable),
" (", round(100 * share), "%)", collapse = "<br>"),
.groups = "drop") %>%
mutate(features = paste0(features, "<br><small><i>", n_top, " of ", n_sig,
" significant features</i></small>")) %>%
select(basis, component, features)
loadings <- map_dfr(
c("pca", "varimax"),
function(b) map_dfr(c("all", "gross", "fine"), ~ read_loadings(b, .x))
)
interpretation <- coefs %>%
filter(credible) %>%
select(basis, component, contrast, effect = estimate) %>%
inner_join(loadings, by = c("basis", "component")) %>%
filter(sig_loading) %>%
mutate(
# keep full `feature`; also split leading category from the measure name
category = if_else(str_detect(variable, "^[^_]+__[^_]+__"),
str_extract(variable, "^[^_]+__[^_]+"),   # e.g. "gross__rwrist"
NA_character_),
measure  = if_else(str_detect(variable, "^[^_]+__[^_]+__"),
str_remove(variable, "^[^_]+__[^_]+__"),  # e.g. "speed_mean"
variable),
moves    = if_else(sign(effect) == sign(loading_sign), "↑ more", "↓ less")
) %>%
arrange(basis, contrast, component, category, desc(abs(loading))) %>%
relocate(category, measure, .after = component)
interpretation
loadings <- map_dfr(
c("pca", "varimax"),
function(b) map_dfr(c("all", "gross", "fine"), ~ read_loadings(b, .x))
)
