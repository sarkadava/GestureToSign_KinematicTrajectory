            <CVE_VALUE
                DESCRIPTION="Spreading/Aperture: contact; Repetition/Alternation: not present" LANG_REF="eng">False</CVE_VALUE>
            <CVE_VALUE LANG_REF="deu">Falsch</CVE_VALUE>
        </CV_ENTRY_ML>
        <CV_ENTRY_ML CVE_ID="cveid_7519a6b4-6137-4cdd-84f9-9df8c5b443b8">
            <CVE_VALUE
                DESCRIPTION="Spreading/Aperture: no contact; Repetition/Alternation: present." LANG_REF="eng">True</CVE_VALUE>
            <CVE_VALUE LANG_REF="deu">Wahr</CVE_VALUE>
        </CV_ENTRY_ML>
        <CV_ENTRY_ML CVE_ID="cveid_733b32f7-4714-40d3-8e8c-530cfb370626">
            <CVE_VALUE DESCRIPTION="Spreading/Aperture: not applicable" LANG_REF="eng">NA</CVE_VALUE>
